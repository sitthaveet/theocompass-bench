{
  "name": "theocompass-bench",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitthaveet/theocompass-bench.git"
  },
  "bugs": {
    "url": "https://github.com/sitthaveet/theocompass-bench/issues"
  },
  "homepage": "https://github.com/sitthaveet/theocompass-bench#readme",
  "description": "A reproducible CLI benchmark of theological positions expressed by AI models using TheoCompass questionnaires and scoring.",
  "keywords": ["ai", "benchmark", "theology", "theocompass", "evaluation"],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bench": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "data:prepare": "npm run bench -- prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:publication": "node scripts/check-publication.mjs",
    "check": "npm run check:publication && npm run typecheck && npm test"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
